{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	// Matches the previous prettier.config.js
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"svelte": true,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	// Pre-existing project code with its own style, not part of the
	// SvelteKit app (see AGENTS.md) — kept out of the app's format scope,
	// same as the previous .prettierignore.
	"ignorePatterns": [
		"userscript/**",
		"server/**",
		"tools/**",
		"docs/**",
		"AGENTS.md",
		"README.md",
		"captures/**",
		".agents/**",
		".mcp.json",
		"skills-lock.json"
	]
}
