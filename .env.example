# Copy to .env (gitignored) and fill in real values for local dev.
# node --env-file=.env is used to load this, per tools/probe-login.ts.

# Path to the SQLite cache file. Defaults to data/dementor.sqlite
# (gitignored) if unset — this is a rebuildable cache of InfoMentor's
# own API responses, not a source of truth, so losing it just means
# the next login rebuilds it.
DATABASE_PATH=data/dementor.sqlite

# Directory for the Phase-4 cached media (Lärlogg photos/videos).
# Defaults to data/media. Override if you want it on a different
# disk than the SQLite file (e.g. SQLite on a fast SSD, media on
# bulk storage). Robust to restart: re-downloads what was lost.
MEDIA_DIR=data/media

# InfoMentor credentials are NOT set here — each parent enters their
# own username/password on the login form every time. There is no
# dashboard user account, no encrypted-at-rest credential storage, no
# master key. The InfoMentor session cookie lives in process memory
# only, scoped to a random opaque session token held as an HttpOnly
# cookie, and is dropped on logout or server restart.
