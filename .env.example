# Copy to .env (gitignored) and fill in real values for local dev.
# node --env-file=.env is used to load this, per tools/probe-login.ts.

# Path to the SQLite cache file. Defaults to data/dementor.sqlite
# (gitignored) if unset — this is a rebuildable cache of InfoMentor's
# own API responses, not a source of truth, so losing it just means
# the next sync rebuilds it.
DATABASE_PATH=data/dementor.sqlite

# Signs/validates the dashboard session cookie (Phase 1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM master key used to encrypt each parent's stored InfoMentor
# password at rest (Phase 2). Generate the same way as SESSION_SECRET —
# needs to be 32 bytes (64 hex chars).
CREDENTIALS_ENCRYPTION_KEY=

# InfoMentor credentials are NOT set here — each parent enters their own
# username/password through the app itself (Phase 2's settings page),
# encrypted at rest with CREDENTIALS_ENCRYPTION_KEY above.
